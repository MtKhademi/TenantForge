# Public test deployment: copy to /opt/tenantforge/tenantforge.env; chmod 600.
# Never commit the real env file. Use simple single-line values (no shell quotes).
TENANTFORGE_DB_PASSWORD=replace-with-long-random-password
IAM__Auth__SigningKey=replace-with-long-random-signing-key-at-least-32-characters
IAM__SeedAdmin__Email=admin@example.com
IAM__SeedAdmin__Password=replace-with-long-random-password
IAM__SeedAdmin__DisplayName=Platform Administrator
Shop__CartCleanupIntervalSeconds=3600
Shop__Payments__Provider=Sandbox
# Docker Compose publishes the test web app on all host interfaces.
TENANTFORGE_PORT=8581
