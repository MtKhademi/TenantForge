# Copy to /opt/tenantforge/tenantforge.env on the server; chmod 600.
# Never commit the real env file. Use simple single-line values (no shell quotes).
TENANTFORGE_DB_PASSWORD=replace-with-long-random-password
IAM__Auth__SigningKey=replace-with-long-random-signing-key-at-least-32-characters
IAM__SeedAdmin__Email=admin@example.com
IAM__SeedAdmin__Password=replace-with-long-random-password
IAM__SeedAdmin__DisplayName=Platform Administrator
Shop__CartReservationMinutes=30
Shop__CartCleanupIntervalSeconds=3600
Shop__Payments__Provider=ZarinPal
Shop__Payments__ZarinPal__MerchantId=replace-with-real-merchant-id
Shop__Payments__ZarinPal__Currency=IRT
Shop__Payments__ZarinPal__RequestEndpoint=https://api.zarinpal.com/v4/payment/request
Shop__Payments__ZarinPal__VerifyEndpoint=https://api.zarinpal.com/v4/payment/verify
Shop__Payments__ZarinPal__GatewayBaseUrl=https://checkout.zarinpal.com/payment/
Shop__Payments__ZarinPal__PublicApiBaseUrl=https://your-domain.example
Shop__Payments__ZarinPal__FrontendResultBaseUrl=https://your-domain.example
Shop__RateLimiting__OrderLookupPerMinute=30
Shop__RateLimiting__CartMutationPerMinute=120
Shop__RateLimiting__CheckoutOrderPerMinute=30
Shop__RateLimiting__PaymentInitiationPerMinute=20
Shop__RateLimiting__MaxRequestBodyBytes=524288
# Keep localhost unless a trusted HTTPS reverse proxy fronts this port.
TENANTFORGE_BIND_ADDRESS=127.0.0.1
TENANTFORGE_PORT=8581
