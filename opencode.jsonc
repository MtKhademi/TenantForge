{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "external_directory": "deny",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current*": "allow",
      "git push*": "deny",
      "git force*": "deny"
    }
  }
}
